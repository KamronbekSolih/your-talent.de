# Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Analytics only loads after a visitor accepts cookies in the consent banner.
# Leave unset to disable analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
